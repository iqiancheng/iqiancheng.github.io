---
layout: compress
swcache: true
---
[
{%- assign first = true -%}
{%- for post in site.posts -%}
  {%- if post.title == nil or post.title == "" -%}{%- continue -%}{%- endif -%}

  {%- comment -%}
    Search index tuned for Simple-Jekyll-Search (literal strategy):
    - jsonify everywhere → valid JSON (fixes \sum etc. breaking parse)
    - body: title + tags (+ hyphen→space) + categories + description + ~1200 body chars
    - content: short snippet for the result list UI only
    - exclude url/date at query time so long body drives recall
  {%- endcomment -%}

  {%- capture raw_body -%}
    {{- post.content | strip_html | strip_newlines | normalize_whitespace -}}
  {%- endcapture -%}

  {%- assign tag_joined = post.tags | join: ' ' -%}
  {%- assign tag_spaced = tag_joined | replace: '-', ' ' -%}
  {%- assign cat_joined = post.categories | join: ' ' -%}

  {%- capture search_blob -%}
    {{- post.title -}}{{- ' ' -}}
    {{- tag_joined -}}{{- ' ' -}}
    {{- tag_spaced -}}{{- ' ' -}}
    {{- cat_joined -}}{{- ' ' -}}
    {%- if post.description -%}
      {{- post.description | strip_html | normalize_whitespace -}}{{- ' ' -}}
    {%- endif -%}
    {{- raw_body | truncate: 1200, '' -}}
  {%- endcapture -%}

  {%- capture snippet -%}
    {%- if post.description -%}
      {{- post.description | strip_html | normalize_whitespace | truncate: 160 -}}
    {%- else -%}
      {{- raw_body | truncate: 160 -}}
    {%- endif -%}
  {%- endcapture -%}

  {%- unless first -%},{%- endunless -%}
  {%- assign first = false -%}
  {
    "title": {{ post.title | jsonify }},
    "url": {{ post.url | relative_url | jsonify }},
    "categories": {{ cat_joined | jsonify }},
    "tags": {{ tag_joined | jsonify }},
    "date": {{ post.date | date: "%Y-%m-%d" | jsonify }},
    "content": {{ snippet | strip | jsonify }},
    "body": {{ search_blob | strip | normalize_whitespace | jsonify }}
  }
{%- endfor -%}
]
